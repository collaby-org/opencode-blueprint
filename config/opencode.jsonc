{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  "instructions": ["AGENTS.md"],
  "model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "tokenharbor": {
      "name": "Token Harbor",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://tokenharbor.ai/v1"
      },
      "models": {
        "th-orchestra": {
          "name": "Token Harbor"
        },
        "muse-spark-1-3": {
          "name": "Muse Spark 1.3 (Token Harbor)"
        },
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash"
        },
        "deepseek-v4-flash:free": {
          "name": "DeepSeek V4 Flash"
        },
        "mimo-v2.5:free": {
          "name": "MiMo V2.5"
        }
      }
    },
    "omnirouter": {
      "name": "Omni Router",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "auto": {
          "name": "OmniRoute Auto"
        }
      }
    },
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      },
      "models": {
        "muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Free"
        }
      }
    }
  },
  "plugin": [
    "opencode-mem",
    "oh-my-opencode-slim"
    // dcp is vendored locally at plugins/opencode-dcp (pending upstream #608
    // visible-tag fix) — path plugins auto-load, so no npm entry here;
    // leaving "@tarquinen/opencode-dcp" would double-load it.
    // Local path plugins (opencode-github-release, opencode-telemetry,
    // opencode-ralph-wiggum, envsitter-guard, opencode-log-sanitizer,
    // opencode-command-inject, opencode-review, opencode-dcp) — all export
    // v2 { id, setup } and auto-load from plugins/, so no npm entries here.
  ],
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    // Google remote MCPs require a pre-registered OAuth client (no Dynamic Client
    // Registration) — disabled until oauth clientId/secret or bearer header is
    // configured; re-enable per https://docs.cloud.google.com/mcp/set-up-authentication-mcp-servers.
    "gcp-bigquery": {
      "type": "remote",
      "url": "https://bigquery.googleapis.com/mcp",
      "enabled": false
    },
    "gcp-compute": {
      "type": "remote",
      "url": "https://compute.googleapis.com/mcp",
      "enabled": false
    },
    "gcp-gke": {
      "type": "remote",
      "url": "https://container.googleapis.com/mcp",
      "enabled": false
    },
    "gcp-run": {
      "type": "remote",
      "url": "https://run.googleapis.com/mcp",
      "enabled": false
    },
    "gcp-storage": {
      "type": "remote",
      "url": "https://storage.googleapis.com/storage/mcp",
      "enabled": false
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "headers": {
        "Authorization": "Sentry-Bearer {env:SENTRY_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "google-analytics": {
      "type": "local",
      "command": ["C:\\Users\\horgh\\.config\\opencode\\tools\\analytics-mcp\\.venv\\Scripts\\analytics-mcp.exe"],
      "environment": {
        "GOOGLE_APPLICATION_CREDENTIALS": "{env:GOOGLE_APPLICATION_CREDENTIALS}",
        "GOOGLE_PROJECT_ID": "{env:GOOGLE_PROJECT_ID}"
      },
      "enabled": true
    },
    "prisma": {
      "type": "local",
      "command": ["C:\\Program Files\\nodejs\\node.exe", "C:\\Users\\horgh\\.config\\opencode\\tools\\prisma\\node_modules\\prisma\\build\\index.js", "mcp"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["C:\\Program Files\\nodejs\\node.exe", "C:\\Users\\horgh\\.config\\opencode\\tools\\postgres-mcp\\node_modules\\@modelcontextprotocol\\server-postgres\\dist\\index.js", "{env:DATABASE_URL}"],
      "enabled": true
    },
    "mongodb": {
      "type": "local",
      "command": ["C:\\Program Files\\nodejs\\node.exe", "C:\\Users\\horgh\\.config\\opencode\\tools\\mongodb-mcp\\node_modules\\mongodb-mcp-server\\dist\\esm\\index.js", "--readOnly"],
      "environment": {
        "MDB_MCP_CONNECTION_STRING": "{env:MDB_MCP_CONNECTION_STRING}"
      },
      "enabled": true
    },
    "redis": {
      "type": "local",
      "command": ["C:\\Users\\horgh\\AppData\\Local\\Programs\\Python\\Python314\\Scripts\\redis-mcp-server.exe", "--url", "{env:REDIS_URL}"],
      "enabled": true
    },
    "kubernetes": {
      "type": "local",
      "command": ["C:\\Users\\horgh\\.config\\opencode\\tools\\kubernetes-mcp\\node_modules\\kubernetes-mcp-server-windows-amd64\\bin\\kubernetes-mcp-server-windows-amd64.exe", "--log-file", "stderr"],
      "enabled": true
    },
    "expo": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp",
      "enabled": true
    },
    "lucide-animated": {
      "type": "remote",
      "url": "https://lucide-animated.com/mcp",
      "enabled": true
    },
    // Pinned runtime + pinned CLI script, not `npx`: `npx` resolves whatever
    // `node` is first on PATH, and rea-agents@6.5.0 needs Node >= 20.12
    // (Node 18 dies on node:util styleText); a bare `npx -y rea-agents` also
    // exits 0 after a help banner without ever handshaking. Both paths below
    // are machine-specific — bin/setup.mjs repoints them on install (an
    // nvm version dir is not portable across machines).
    "rea": {
      "type": "local",
      "command": ["C:\\Users\\horgh\\AppData\\Local\\nvm\\v26.10.0\\node.exe", "C:\\Users\\horgh\\.config\\opencode\\tools\\rea-agents\\node_modules\\rea-agents\\scripts\\rea.mjs", "mcp"],
      "enabled": true
    }
  }
}