# OpenCode lane-1 env template — PLACEHOLDERS ONLY, never paste real secrets here
# Location: %USERPROFILE%\.config\opencode\.env.example (same dir as opencode.jsonc)
# Usage: copy to .env in same dir (or export as system env vars), fill values, restart OpenCode.
# Wired in opencode.jsonc via {env:VAR_NAME}. Lane 2 will validate wiring after librarian results.
# Docs links included per var. No secrets stored in this file.

# ------------------------------------------------------------------
# DATABASE_URL
# WHAT FOR: postgres MCP (npx -y @modelcontextprotocol/server-postgres "{env:DATABASE_URL}")
#           + Prisma Postgres access. Gives AI read/query access to your Postgres DB.
# WHERE TO GET: your Postgres provider dashboard (local Postgres, Supabase, Neon, Cloud SQL):
#   Supabase: dashboard Project > Connect > Connection string
#   Neon: dashboard > Connect
#   Local: postgresql://USER:PASSWORD@localhost:5432/DBNAME
# DOCS: https://www.postgresql.org/docs/current/libpq-connect.html
#       https://github.com/modelcontextprotocol/servers/tree/main/src/postgres
#       https://www.prisma.io/docs/concepts/database-connectors/postgresql
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ------------------------------------------------------------------
# MDB_MCP_CONNECTION_STRING
# WHAT FOR: mongodb MCP (npx -y mongodb-mcp-server@latest --readOnly)
#           env MDB_MCP_CONNECTION_STRING. Read-only MongoDB Atlas/local access.
# WHERE TO GET: MongoDB Atlas > Database > Connect > Drivers / Compass > copy connection string
#   then replace <username>/<password>. For local: mongodb://localhost:27017/DBNAME
# DOCS: https://www.mongodb.com/docs/atlas/db-connection-string/
#       https://github.com/mongodb-js/mongodb-mcp-server
MDB_MCP_CONNECTION_STRING=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DBNAME?retryWrites=true&w=majority

# ------------------------------------------------------------------
# REDIS_URL
# WHAT FOR: redis MCP (redis-mcp-server.exe --url "{env:REDIS_URL}").
#           Cache / session / queue inspection.
# WHERE TO GET: local `redis-server` (redis://localhost:6379/0) or managed:
#   Upstash: console > Redis DB > Connect > copy URL
#   Memorystore / Elasticache: GCP/AWS console connection endpoint
# DOCS: https://redis.io/docs/latest/develop/clients/client-list/
#       https://upstash.com/docs/redis
#       https://cloud.google.com/memorystore/docs/redis
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS
# WHAT FOR: google-analytics MCP (pipx run analytics-mcp) env.
#           Filesystem PATH to GCP service-account JSON key (NOT the JSON content itself).
# WHERE TO GET: Google Cloud Console > IAM & Admin > Service Accounts > select/ create SA
#   > Keys > Add Key > Create new key > JSON > download .json, save locally, paste PATH here.
# DOCS: https://cloud.google.com/docs/authentication/application-default-credentials
#       https://cloud.google.com/iam/docs/keys-create-delete
#       https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\horgh\.config\gcloud\service-account.json

# ------------------------------------------------------------------
# GOOGLE_PROJECT_ID
# WHAT FOR: google-analytics MCP env + gcp-bigquery/compute/gke/run/storage MCPs.
#           Selects which GCP project to query.
# WHERE TO GET: Google Cloud Console dashboard > Project ID (not project name/number).
#   `gcloud projects list` also shows it.
# DOCS: https://cloud.google.com/resource-manager/docs/creating-managing-projects
#       https://console.cloud.google.com/
GOOGLE_PROJECT_ID=your-gcp-project-id

# ------------------------------------------------------------------
# CONTEXT7_API_KEY
# WHAT FOR: context7 remote MCP Authorization: Bearer {env:CONTEXT7_API_KEY}.
#           Up-to-date library docs fetch (https://mcp.context7.com/mcp).
# WHERE TO GET: https://context7.com/dashboard > API Keys > Create.
# DOCS: https://context7.com/docs
#       https://github.com/upstash/context7
CONTEXT7_API_KEY=ctx7_YOUR_KEY_HERE

# ------------------------------------------------------------------
# SENTRY_ACCESS_TOKEN
# WHAT FOR: sentry remote MCP Authorization: Sentry-Bearer {env:SENTRY_ACCESS_TOKEN}.
#           Sentry error / performance inspection (https://mcp.sentry.dev/mcp).
# WHERE TO GET: Sentry > Organization Settings > API > Auth Tokens (or https://sentry.io/settings/account/api/auth-tokens/)
#   Create token with project:read / event:read scopes.
# DOCS: https://docs.sentry.io/api/auth/
#       https://docs.sentry.io/product/sentry-mcp/
SENTRY_ACCESS_TOKEN=sntrys_YOUR_TOKEN_HERE

# ------------------------------------------------------------------
# OPENCODE_ZEN_API_KEY
# WHAT FOR: opencode provider.options.apiKey = {env:OPENCODE_ZEN_API_KEY}.
#           Authenticates muse-spark-1.3-contributor-free via OpenCode Zen gateway.
# WHERE TO GET: https://opencode.ai/auth (sign in) or Zen dashboard > API Keys.
# DOCS: https://opencode.ai/docs/zen/
#       https://opencode.ai/docs/providers/
OPENCODE_ZEN_API_KEY=zen_YOUR_KEY_HERE
